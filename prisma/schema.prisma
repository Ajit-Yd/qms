generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id         String      @id @default(cuid())
  name       String      @unique
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  profiles   Profile[]
  committees Committee[]
}

model Profile {
  id          String        @id @default(cuid())
  name        String
  email       String?
  passwordHash String?
  roleTitle   String
  reportsTo   String?
  active      Boolean       @default(true)
  canManageCommittees Boolean @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // "primary_admin" (one global owner), "org_admin" (this org's admin), "member"
  systemRole String        @default("member")
  passwordResetTokens PasswordResetToken[]
  reportsToProfile Profile? @relation("ProfileReportsTo", fields: [reportsTo], references: [id], onDelete: SetNull)
  subordinates Profile[]    @relation("ProfileReportsTo")
  createdAt   DateTime      @default(now())

  documentAssignments       Document[]      @relation("DocumentAssignedTo")
  documentCreatedBy         Document[]      @relation("DocumentAssignedBy")
  capaAssignments           Capa[]          @relation("CapaAssignedTo")
  capaCreatedBy             Capa[]          @relation("CapaAssignedBy")
  nonconformanceAssignments Nonconformance[] @relation("NonconformanceAssignedTo")
  nonconformanceCreatedBy   Nonconformance[] @relation("NonconformanceAssignedBy")
  auditAssignments          Audit[]         @relation("AuditAssignedTo")
  auditCreatedBy            Audit[]          @relation("AuditAssignedBy")
  trainingAssignments       Training[]      @relation("TrainingAssignedTo")
  trainingCreatedBy         Training[]      @relation("TrainingAssignedBy")
  
  committeeCreations     Committee[]     @relation("CommitteeCreatedBy")
  committeeMemberships   CommitteeMembership[]
  committeeTaskAssignments CommitteeTask[] @relation("CommitteeTaskAssignedTo")
  committeeTaskAssignedBy  CommitteeTask[] @relation("CommitteeTaskAssignedBy")
  meetingsOrganized     Meeting[]       @relation("MeetingOrganizer")
  meetingAttendances     MeetingAttendee[]

  @@index([reportsTo])
  @@index([organizationId])
  @@unique([organizationId, email])
}

model Document {
  id        String   @id @default(cuid())
  title     String
  assignedTo String
  assigned  Profile  @relation("DocumentAssignedTo", fields: [assignedTo], references: [id], onDelete: Cascade)
  assignedBy String?
  assignedByProfile Profile? @relation("DocumentAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  status    String
  revision  String
  updated   DateTime @default(now())
  deletedAt DateTime?
  fileName  String?
  fileType  String?
  fileSize  Int?
  fileData  String?  @db.Text // base64 for Vercel ephemeral FS

  @@index([assignedTo])
  @@index([assignedBy])
  @@index([deletedAt])
}

model Capa {
  id          String    @id @default(cuid())
  title       String
  assignedTo  String
  assigned    Profile   @relation("CapaAssignedTo", fields: [assignedTo], references: [id], onDelete: Cascade)
  assignedBy  String?
  assignedByProfile Profile? @relation("CapaAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  priority    String
  status      String
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  fileName  String?
  fileType  String?
  fileSize  Int?
  fileData  String?  @db.Text // base64; see src/lib/files.ts for limits

  @@index([assignedTo])
  @@index([assignedBy])
  @@index([deletedAt])
}

model Nonconformance {
  id          String    @id @default(cuid())
  title       String
  assignedTo  String
  assigned    Profile   @relation("NonconformanceAssignedTo", fields: [assignedTo], references: [id], onDelete: Cascade)
  assignedBy  String?
  assignedByProfile Profile? @relation("NonconformanceAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  source      String
  severity    String
  status      String
  date        DateTime  @default(now())
  deletedAt   DateTime?
  fileName  String?
  fileType  String?
  fileSize  Int?
  fileData  String?  @db.Text // base64; see src/lib/files.ts for limits

  @@index([assignedTo])
  @@index([assignedBy])
  @@index([deletedAt])
}

model Audit {
  id          String    @id @default(cuid())
  title       String
  assignedTo  String
  assigned    Profile   @relation("AuditAssignedTo", fields: [assignedTo], references: [id], onDelete: Cascade)
  assignedBy  String?
  assignedByProfile Profile? @relation("AuditAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  status      String
  date        DateTime  @default(now())
  deletedAt   DateTime?
  fileName  String?
  fileType  String?
  fileSize  Int?
  fileData  String?  @db.Text // base64; see src/lib/files.ts for limits

  @@index([assignedTo])
  @@index([assignedBy])
  @@index([deletedAt])
}

model Training {
  id          String    @id @default(cuid())
  employee    String
  course      String
  status      String
  dueDate     DateTime?
  assignedTo  String
  assigned    Profile   @relation("TrainingAssignedTo", fields: [assignedTo], references: [id], onDelete: Cascade)
  assignedBy  String?
  assignedByProfile Profile? @relation("TrainingAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  fileName  String?
  fileType  String?
  fileSize  Int?
  fileData  String?  @db.Text // base64; see src/lib/files.ts for limits

  @@index([assignedTo])
  @@index([assignedBy])
  @@index([deletedAt])
}

model Committee {
  id          String   @id @default(cuid())
  name        String
  description String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy   String
  createdByProfile Profile @relation("CommitteeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  memberships CommitteeMembership[]
  tasks       CommitteeTask[]
  meetings    Meeting[]

  @@index([createdBy])
  @@index([organizationId])
}

model CommitteeMembership {
  id                String   @id @default(cuid())
  committeeId       String
  committee         Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  roleInCommittee   String   @default("member") // "head" or "member"
  joinedAt          DateTime @default(now())

  @@unique([committeeId, profileId])
  @@index([committeeId])
  @@index([profileId])
}

model CommitteeTask {
  id          String   @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assignedTo  String
  assignedToProfile Profile @relation("CommitteeTaskAssignedTo", fields: [assignedTo], references: [id], onDelete: Restrict)
  assignedBy  String
  assignedByProfile Profile @relation("CommitteeTaskAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)
  status      String   @default("assigned") // "assigned", "in_progress", "submitted", "approved"
  dueDate     DateTime?
  responseNote String?
  linkUrl     String?
  fileName    String?
  fileType    String?
  fileSize    Int?
  fileData    String?  @db.Text // base64; see src/lib/files.ts for limits
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  @@index([committeeId])
  @@index([assignedTo])
  @@index([assignedBy])
  @@index([status])
}

model Meeting {
  id          String   @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  title       String
  agenda      String?
  notes       String?
  scheduledAt DateTime
  location    String?
  linkUrl     String?
  organizedBy String
  organizer   Profile  @relation("MeetingOrganizer", fields: [organizedBy], references: [id], onDelete: Restrict)
  attendees   MeetingAttendee[]
  createdAt   DateTime @default(now())

  @@index([committeeId])
  @@index([scheduledAt])
}

model MeetingAttendee {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  attended  Boolean  @default(false)

  @@unique([meetingId, profileId])
  @@index([profileId])
}

model RecordHistory {
  id          String   @id @default(cuid())
  recordType  String
  recordId    String
  fromStatus  String?
  toStatus    String
  changedBy   String
  comment     String?
  createdAt   DateTime @default(now())

  @@index([recordType, recordId])
  @@index([changedBy])
}

model Comment {
  id         String   @id @default(cuid())
  recordType String
  recordId   String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  @@index([recordType, recordId])
  @@index([authorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId])
  @@index([expiresAt])
}
